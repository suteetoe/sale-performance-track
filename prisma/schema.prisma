generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sale Order (trans_flag=36) และ Sale Invoice (trans_flag=44) อยู่ใน table เดียวกัน
model IcTrans {
  doc_no     String   @db.VarChar(255)
  trans_flag Int
  doc_date   DateTime @db.Date
  doc_time   String   @db.VarChar(10)

  @@id([doc_no, trans_flag])
  @@map("ic_trans")
}

// เชื่อมโยง Sale Invoice → Sale Order
// doc_no     = Sale Invoice doc_no (trans_flag=44)
// billing_no = Sale Order doc_no   (trans_flag=36)
model ApArTransDetail {
  roworder   Int    @id @default(autoincrement())
  doc_no     String @db.VarChar(50)
  billing_no String @db.VarChar(50)

  @@map("ap_ar_trans_detail")
}

// Delivery Order
model DeliveryOrder {
  doc_no   String                @id @db.VarChar(255)
  doc_date DateTime              @db.Date
  doc_time String                @db.VarChar(10)
  details  DeliveryOrderDetail[]

  @@map("pp_shipment")
}

// เชื่อมโยง Delivery → Sale Invoice
// doc_no     = Delivery Order doc_no
// ref_doc_no = Sale Invoice doc_no (trans_flag=44)
model DeliveryOrderDetail {
  roworder   Int           @id @default(autoincrement())
  doc_no     String        @db.VarChar(255)
  ref_doc_no String        @db.VarChar(255)
  delivery   DeliveryOrder @relation(fields: [doc_no], references: [doc_no])

  @@map("pp_shipment_detail")
}

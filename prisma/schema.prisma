generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ic_trans ───────────────────────────────────────────────────────────────
// table เดียวเก็บหลายประเภทเอกสาร แยกด้วย trans_flag
//   trans_flag = 36  → Sale Order
//   trans_flag = 44  → Sale Invoice
//   trans_flag = 701 → Delivery Order
model IcTrans {
  doc_no     String   @db.VarChar(255)
  trans_flag Int
  doc_date   DateTime @db.Date
  doc_time   String   @db.VarChar(10)

  @@id([doc_no, trans_flag])
  @@map("ic_trans")
}

// ─── ap_ar_trans_detail ─────────────────────────────────────────────────────
// เชื่อมโยง Sale Invoice → Sale Order
//   doc_no     = Sale Invoice doc_no (trans_flag=44)
//   billing_no = Sale Order doc_no   (trans_flag=36)
model ApArTransDetail {
  roworder   Int    @id @default(autoincrement())
  doc_no     String @db.VarChar(50)
  billing_no String @db.VarChar(50)

  @@map("ap_ar_trans_detail")
}

// ─── ic_trans_detail ────────────────────────────────────────────────────────
// เชื่อมโยง Delivery Order → Sale Invoice
//   doc_no    = Delivery Order doc_no (→ ic_trans trans_flag=701)
//   item_code = Sale Invoice doc_no   (trans_flag=44)
model IcTransDetail {
  roworder  Int    @id @default(autoincrement())
  doc_no    String @db.VarChar(255)
  item_code String @db.VarChar(255)

  @@map("ic_trans_detail")
}
